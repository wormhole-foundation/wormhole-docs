{
  "name": "wh-doc-gen",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "update": "npx npm-check-updates -u && npm install --silent",
    "generate": "node --import tsx src/fetchAllProductChains.ts && node --import tsx src/index.ts",
    "check:consts": "npx tsx src/check.ts",
    "check:links": "find ../docs -name \\*.md -print0 | xargs -0 -n1 npx markdown-link-check",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "markdown-link-check": "^3.15.0",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@wormhole-foundation/sdk": "6.1.5",
    "axios": "^1.19.0",
    "sharp": "^0.35.3",
    "swagger-markdown": "^3.1.1"
  }
}
